{
  "name": "orchestra-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/server/db/cli.ts migrate",
    "db:seed": "tsx src/server/db/cli.ts seed",
    "db:ping": "tsx src/server/db/cli.ts ping",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "auth:schema": "better-auth generate --config src/server/auth.ts --output /dev/stdout"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-sfn": "^3.1156.0",
    "@aws-sdk/rds-signer": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "midi-file": "^1.2.4",
    "mp4-muxer": "^5.2.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
