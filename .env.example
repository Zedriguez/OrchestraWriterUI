# Copy to .env.local (gitignored). Every value below has a local default that
# matches docker-compose.yml, so `docker compose up -d && npm run dev` works
# with no .env at all. Production (App Runner) sets the real values.

# --- Postgres (docker compose: localhost:5433, db orchestra) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=orchestra
DB_USER=postgres
DB_PASSWORD=orchestra
DB_SSL=false
# Aurora with IAM auth: leave DB_PASSWORD empty, DB_SSL=true, and give the
# process AWS credentials with rds-db:connect (see infra/README.md).
DB_SSL_VERIFY=true
DB_SSL_CA_PATH=

# --- S3 (docker compose: S3Mock on localhost:9090, bucket orchestra-audio) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_AUDIO_BUCKET=orchestra-audio
S3_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://localhost:9090

# --- Auth (Better Auth) ---
# `openssl rand -base64 32` in production. Any string locally.
BETTER_AUTH_SECRET=local-only-secret-not-for-production
# Public origin of the site; OAuth callbacks are built from it.
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in appears only when both are set. Register
# <BETTER_AUTH_URL>/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transcription pipeline (optional; inline locally) ---
STATE_MACHINE_ARN=
PIPELINE_MODE=inline

# --- Next ---
PORT=3000
# Set to 1 to run the front end on the in-memory mock API (no backend needed).
NEXT_PUBLIC_API_MOCK=
